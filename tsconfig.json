{
    "compilerOptions": {
      "target": "ES2020",
      "module": "commonjs",
      "rootDir": "",
      "outDir": "dist",
      "strict": true,
      "moduleResolution": "node",
      "esModuleInterop": true,
      "forceConsistentCasingInFileNames": true,
      "skipLibCheck": true
    },
    "include": ["src", "app.js"],
    "exclude": ["node_modules", "dist"]
  }
  